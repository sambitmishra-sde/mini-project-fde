# Copy this file to `.env` and fill in your key. `.env` is git-ignored - never commit keys.
# Any OpenAI-compatible provider works. Examples:
#   Groq   : LLM_BASE_URL=https://api.groq.com/openai/v1                         LLM_MODEL=llama-3.1-8b-instant
#   OpenAI : LLM_BASE_URL=https://api.openai.com/v1                              LLM_MODEL=gpt-4o-mini
#   Gemini : LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant

# Linux only (docker compose): lets the container write to ./output as your user
# AIRFLOW_UID=1000
